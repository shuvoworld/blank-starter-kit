<?php

namespace App\Policies;

use App\Models\{ModuleName};
use App\Models\User;
use Illuminate\Auth\Access\HandlesAuthorization;

class {ModuleName}Policy
{
    use HandlesAuthorization;

    /**
     * Superusers bypass all policy checks.
     */
    public function before(User $user, string $ability): bool|null
    {
        if ($user->hasRole('Superuser')) {
            return true;
        }

        return null;
    }

    public function viewAny(User $user): bool
    {
        return $user->can('view {module names}');
    }

    public function view(User $user, {ModuleName} ${moduleName}): bool
    {
        return $user->can('view {module names}');
    }

    public function create(User $user): bool
    {
        return $user->can('create {module names}');
    }

    public function update(User $user, {ModuleName} ${moduleName}): bool
    {
        return $user->can('update {module names}');
    }

    public function delete(User $user, {ModuleName} ${moduleName}): bool
    {
        return $user->can('delete {module names}');
    }
}
