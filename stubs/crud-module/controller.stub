<?php

namespace App\Http\Controllers;

use App\Http\Controllers\BaseController\BaseController;
use App\Http\Requests\Store{ModuleName}Request;
use App\Http\Requests\Update{ModuleName}Request;
use App\Models\{ModuleName};
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\RedirectResponse;
use Illuminate\View\View;

class {ModuleName}Controller extends BaseController
{
    public function __construct({ModuleName}DataTableController $dataTableController)
    {
        $this->model = {ModuleName}::class;
        $this->routePrefix = '{module-names}';
        $this->viewPrefix = '{module-names}';
        $this->resourceName = '{Module Name}';
        $this->dataTableController = $dataTableController;
    }

    protected function authorizeAction(string $ability, ?Model $record = null): void
    {
        if ($record) {
            $this->authorize($ability, $record);
        } else {
            $this->authorize($ability, {ModuleName}::class);
        }
    }

    public function show(int|string $record): View
    {
        ${moduleName} = $this->findRecord($record);
        $this->authorize('view', ${moduleName});

        return view('{module-names}.show', compact('{moduleName}'));
    }

    public function store(Store{ModuleName}Request $request): RedirectResponse
    {
        $this->authorize('create', {ModuleName}::class);

        {ModuleName}::create($request->validated());

        return $this->successRedirect('created');
    }

    public function update(Update{ModuleName}Request $request, int|string $record): RedirectResponse
    {
        ${moduleName} = $this->findRecord($record);
        $this->authorize('update', ${moduleName});

        ${moduleName}->update($request->validated());

        return $this->successRedirect('updated');
    }
}
